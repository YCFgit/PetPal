NODE_ENV=development
HOST=127.0.0.1
PORT=3100
PETPAL_STORAGE=memory
PETPAL_AUTH=development
PETPAL_ENABLE_DEMO_DATA=false
PETPAL_DEV_USER_ID=local-user
PETPAL_DEV_TOKEN=
# Set PETPAL_STORAGE=mysql to use the local MySQL adapter.
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_SOCKET=/tmp/mysql.sock
# MYSQL_DATABASE=petpal_dev
# MYSQL_USER=
# MYSQL_PASSWORD=
# PETPAL_BACKUP_DIR=/Users/your-user/.petpal/backups
